diff --git a/work2/packages/emmett/src/typing/messageSchemaVersion.ts b/src/packages/emmett/src/typing/messageSchemaVersion.ts
new file mode 100644
index 0000000..1a5de9c
--- /dev/null
+++ b/src/packages/emmett/src/typing/messageSchemaVersion.ts
@@ -0,0 +1,35 @@
+import type { DefaultRecord } from './';
+import type { Message, MessageSchemaVersionOf } from './message';
+
+export type SchemaVersionProperty<
+  _Type extends string,
+  SchemaVersion extends number,
+> = number extends SchemaVersion
+  ? { readonly schemaVersion?: SchemaVersion }
+  : SchemaVersion extends 1
+    ? { readonly schemaVersion?: SchemaVersion }
+    : { readonly schemaVersion: SchemaVersion };
+
+export type SchemaVersionArgument<MessageType extends Message> = {
+  schemaVersion: MessageSchemaVersionOf<MessageType>;
+};
+
+export type MetadataArgument<
+  MessageType extends Message,
+  MetaData,
+> = undefined extends MessageType['schemaVersion']
+  ? MetaData
+  : MetaData & SchemaVersionArgument<MessageType>;
+
+export const liftSchemaVersion = (
+  metadataArgument: DefaultRecord | undefined,
+): { metadata?: DefaultRecord; schemaVersion?: unknown } => {
+  if (metadataArgument === undefined || !('schemaVersion' in metadataArgument))
+    return { metadata: metadataArgument };
+
+  const { schemaVersion, ...metadata } = metadataArgument;
+
+  return Object.keys(metadata).length > 0
+    ? { metadata, schemaVersion }
+    : { schemaVersion };
+};
