+export type NoSchemaVersionArgument = { schemaVersion?: never };
+
+type WithoutSchemaVersion<MetaData> = MetaData extends unknown
+  ? Omit<MetaData, 'schemaVersion'>
+  : never;
+
+export type MetadataArgument<
+  MessageType extends Message,
+  MetaData,
+> = undefined extends MessageType['schemaVersion']
+  ? WithoutSchemaVersion<MetaData> & NoSchemaVersionArgument
+  : WithoutSchemaVersion<MetaData> & SchemaVersionArgument<MessageType>;
+
+export type WithoutMetadataSchemaVersion<MessageType> = MessageType extends {
+  metadata: infer MetaData;
+}
+  ? 'schemaVersion' extends keyof MetaData
+    ? Omit<MessageType, 'metadata'> & {
+        readonly metadata: Omit<MetaData, 'schemaVersion'>;
+      }
+    : MessageType
+  : MessageType;
+
+const toNumericSchemaVersion = (value: unknown): number | undefined => {
+  if (typeof value === 'number') return Number.isInteger(value) ? value : undefined;
+  if (typeof value === 'string' && /^[0-9]+$/.test(value)) return Number(value);
+  return undefined;
+};
+
+export const liftSchemaVersion = (
+  metadataArgument: DefaultRecord | undefined,
+): { metadata?: DefaultRecord; schemaVersion?: number } => {
+  if (metadataArgument === undefined || !('schemaVersion' in metadataArgument))
+    return { metadata: metadataArgument };
+
+  const { schemaVersion, ...metadata } = metadataArgument;
+  const numericSchemaVersion = toNumericSchemaVersion(schemaVersion);
+
+  return {
+    ...(Object.keys(metadata).length > 0 ? { metadata } : {}),
+    ...(numericSchemaVersion !== undefined
+      ? { schemaVersion: numericSchemaVersion }
+      : {}),
+  };
+};
