+
+type DeclaresSchemaVersion<MessageType> = MessageType extends Message
+  ? undefined extends MessageType['schemaVersion']
+    ? false
+    : true
+  : false;
+
+type WithRequiredSchemaVersion<MessageType extends Message> =
+  MessageType extends Message
+    ? MessageType & {
+        readonly schemaVersion: MessageSchemaVersionOf<MessageType>;
+      }
+    : never;
+
+export type VersioningResult<
+  Input extends Message,
+  Output extends Message,
+> =
+  true extends DeclaresSchemaVersion<Input> | DeclaresSchemaVersion<Output>
+    ? WithRequiredSchemaVersion<Output>
+    : Output;
