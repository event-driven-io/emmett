{
  "name": "@event-driven-io/emmett-server",
  "version": "0.43.0-beta.50",
  "type": "module",
  "description": "Emmett - HTTP Event Store API exposing Emmett event stores through framework-neutral routes",
  "scripts": {
    "build": "tsdown",
    "build:ts": "tsc",
    "build:ts:watch": "tsc -b --watch",
    "openapi:generate": "tsx scripts/generateOpenApi.ts",
    "test": "run-s test:unit test:int test:e2e",
    "test:unit": "vitest run \".unit.spec\"",
    "test:int": "vitest run \".int.spec\"",
    "test:e2e": "vitest run \".e2e.spec\"",
    "test:watch": "vitest",
    "test:unit:watch": "vitest \".unit.spec\"",
    "test:int:watch": "vitest \".int.spec\"",
    "test:e2e:watch": "vitest \".e2e.spec\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/event-driven-io/emmett.git"
  },
  "keywords": [
    "Event Sourcing",
    "HTTP",
    "OpenAPI"
  ],
  "author": "Oskar Dudycz",
  "bugs": {
    "url": "https://github.com/event-driven-io/emmett/issues"
  },
  "homepage": "https://event-driven-io.github.io/emmett/",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./openapi.json": "./openapi/v1.json"
  },
  "typesVersions": {
    "*": {
      "contract": [
        "./dist/contract.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi"
  ],
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {
    "@event-driven-io/emmett": "0.43.0-beta.50",
    "vitest": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
