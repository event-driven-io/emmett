{
  "openapi": "3.1.0",
  "info": {
    "title": "Emmett Event Store API",
    "version": "1.0.0",
    "description": "Language-neutral HTTP API exposing Emmett event stores: discover streams, inspect them, read messages, and append with optimistic concurrency."
  },
  "tags": [
    {
      "name": "api",
      "description": "API discovery and documentation"
    },
    {
      "name": "streams",
      "description": "Streams and their messages"
    }
  ],
