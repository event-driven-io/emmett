{
  "openapi": "3.1.0",
  "info": {
    "title": "Emmett Event Store API",
    "version": "1.0.0",
    "description": "Language-neutral HTTP API exposing Emmett event stores: discover streams, inspect them, read messages, and append with optimistic concurrency."
  },
  "tags": [
    { "name": "api", "description": "API discovery and documentation" },
    { "name": "streams", "description": "Streams and their messages" }
  ],
  "paths": {
    "/v1": {
      "get": {
        "operationId": "getApiRoot",
        "summary": "API root with versions, capabilities and entry-point links",
        "tags": ["api"],
        "responses": {
          "200": {
            "description": "API root.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiRoot" }
              },
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiRoot" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              },
              "application/prs.hal-forms+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiRoot" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "OpenAPI 3.1 contract served by this API build",
        "tags": ["api"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": {} }
              },
              "application/vnd.oai.openapi+json;version=3.1": {
                "schema": { "type": "object", "properties": {} }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      }
    },
    "/v1/docs": {
      "get": {
        "operationId": "getApiDocumentation",
        "summary": "Human-facing API documentation",
        "tags": ["api"],
        "responses": {
          "200": {
            "description": "HTML documentation.",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      }
    },
    "/v1/streams": {
      "get": {
        "operationId": "listStreams",
        "summary": "Paginated and searchable stream catalog",
        "description": "Requires a catalog-capable backend. Ordering and search semantics are declared in the API root capabilities.",
        "tags": ["streams"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of streams. Defaults to 100. Values above the configured maximum (1000 by default) return 400.",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation token returned by the server.",
            "schema": { "type": "string" }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Backend-supported text search over stream names.",
            "schema": { "type": "string" }
          },
          {
            "name": "streamType",
            "in": "query",
            "required": false,
            "description": "Structured stream-type filter, applied when the stream identity codec recognizes the name.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of streams.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StreamCatalogPage" }
              },
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamCatalogPageHal"
                }
              },
              "application/prs.hal-forms+json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamCatalogPageHal"
                }
              }
            }
          },
          "400": {
            "description": "Invalid limit or cursor.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "501": {
            "description": "Backend does not provide a stream catalog.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      }
    },
    "/v1/streams/{streamName}": {
      "get": {
        "operationId": "getStream",
        "summary": "Stream metadata and links",
        "tags": ["streams"],
        "parameters": [
          {
            "name": "streamName",
            "in": "path",
            "required": true,
            "description": "Opaque stream name, percent-encoded as a single URI path segment. The server does not impose a naming convention.",
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream metadata.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stream" }
              },
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Stream" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              },
              "application/prs.hal-forms+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Stream" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "404": {
            "description": "Stream does not exist.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      },
      "head": {
        "operationId": "streamExists",
        "summary": "Stream existence and current ETag",
        "tags": ["streams"],
        "parameters": [
          {
            "name": "streamName",
            "in": "path",
            "required": true,
            "description": "Opaque stream name, percent-encoded as a single URI path segment. The server does not impose a naming convention.",
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": { "description": "Stream exists." },
          "401": { "description": "Missing or invalid credentials." },
          "403": { "description": "Not permitted." },
          "404": { "description": "Stream does not exist." }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      }
    },
    "/v1/streams/{streamName}/messages": {
      "get": {
        "operationId": "readMessages",
        "summary": "Forward finite read as JSON, HAL, or RFC 7464 JSON text sequence",
        "description": "With `Accept: application/json-seq` the selected range is streamed record by record and the response closes when the range ends. Live following belongs to subscriptions.",
        "tags": ["streams"],
        "parameters": [
          {
            "name": "streamName",
            "in": "path",
            "required": true,
            "description": "Opaque stream name, percent-encoded as a single URI path segment. The server does not impose a naming convention.",
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Stream position as a decimal string, passed to `readStream` as `from`. Defaults to the beginning of the stream.",
            "schema": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Upper stream position as a decimal string, passed to `readStream` as `to`.",
            "schema": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of messages, passed to `readStream` as `maxCount`. For JSON and HAL defaults to 100; values above the configured maximum (1000 by default) return 400. For JSON sequences there is no limit unless provided.",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Returns 304 Not Modified when it matches the current stream ETag.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages in the requested range.",
            "headers": {
              "ETag": {
                "description": "Strong ETag whose opaque value is the current stream version, e.g. \"42\".",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessagePage" }
              },
              "application/hal+json": {
                "schema": { "$ref": "#/components/schemas/MessagePageHal" }
              },
              "application/prs.hal-forms+json": {
                "schema": { "$ref": "#/components/schemas/MessagePageHal" }
              },
              "application/json-seq": {
                "schema": { "$ref": "#/components/schemas/RecordedMessage" }
              }
            }
          },
          "304": {
            "description": "Stream has not changed.",
            "headers": {
              "ETag": {
                "description": "Strong ETag whose opaque value is the current stream version, e.g. \"42\".",
                "schema": { "type": "string" }
              }
            }
          },
          "400": {
            "description": "Invalid range, position or limit.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "404": {
            "description": "Stream does not exist.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      },
      "post": {
        "operationId": "appendMessages",
        "summary": "Append one or more messages with optimistic concurrency",
        "description": "Optimistic concurrency uses conditional headers: `If-Match: \"42\"` expects exact version 42, `If-Match: *` expects the stream to exist, `If-None-Match: *` expects it not to exist, and omitting both disables the check.",
        "tags": ["streams"],
        "parameters": [
          {
            "name": "streamName",
            "in": "path",
            "required": true,
            "description": "Opaque stream name, percent-encoded as a single URI path segment. The server does not impose a naming convention.",
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "description": "Single strong stream version ETag, e.g. \"42\", or `*`.",
            "schema": { "type": "string" }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Only `*`, expecting the stream not to exist.",
            "schema": { "type": "string", "const": "*" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AppendRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Messages appended to an existing stream.",
            "headers": {
              "ETag": {
                "description": "Strong ETag whose opaque value is the current stream version, e.g. \"42\".",
                "schema": { "type": "string" }
              },
              "Location": {
                "description": "URL of the stream resource.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppendResult" }
              },
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/AppendResult" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              },
              "application/prs.hal-forms+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/AppendResult" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Messages appended, creating a new stream.",
            "headers": {
              "ETag": {
                "description": "Strong ETag whose opaque value is the current stream version, e.g. \"42\".",
                "schema": { "type": "string" }
              },
              "Location": {
                "description": "URL of the stream resource.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppendResult" }
              },
              "application/hal+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/AppendResult" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              },
              "application/prs.hal-forms+json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/AppendResult" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or conditional headers.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "403": {
            "description": "Authenticated principal is not permitted to perform the operation.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested representation is not available.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "412": {
            "description": "Expected stream version did not match.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "413": {
            "description": "Body or batch too large.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "415": {
            "description": "Body is not JSON.",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        },
        "security": [{ "apiKey": [] }, { "bearer": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiRoot": {
        "type": "object",
        "required": [
          "apiVersion",
          "contractVersion",
          "serverVersion",
          "capabilities"
        ],
        "properties": {
          "apiVersion": { "type": "string" },
          "contractVersion": { "type": "string" },
          "serverVersion": { "type": "string" },
          "capabilities": {
            "type": "object",
            "required": [
              "streamReads",
              "appends",
              "streamExistence",
              "streamCatalog",
              "finiteStreaming",
              "subscriptions",
              "subscriptionSources",
              "aggregates"
            ],
            "properties": {
              "streamReads": { "type": "boolean" },
              "appends": { "type": "boolean" },
              "streamExistence": { "type": "boolean" },
              "streamCatalog": { "type": "boolean" },
              "finiteStreaming": { "type": "boolean" },
              "subscriptions": { "type": "boolean" },
              "subscriptionSources": {
                "type": "array",
                "items": { "type": "string" }
              },
              "aggregates": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "Stream": {
        "type": "object",
        "required": ["streamName"],
        "properties": {
          "streamName": { "type": "string" },
          "identity": {
            "type": "object",
            "required": ["streamType", "streamId"],
            "properties": {
              "streamType": { "type": "string" },
              "streamId": { "type": "string" }
            }
          }
        }
      },
      "ListedStream": {
        "type": "object",
        "required": ["streamName", "currentStreamVersion"],
        "properties": {
          "streamName": { "type": "string" },
          "currentStreamVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "identity": {
            "type": "object",
            "required": ["streamType", "streamId"],
            "properties": {
              "streamType": { "type": "string" },
              "streamId": { "type": "string" }
            }
          }
        }
      },
      "AppendRequest": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "data"],
              "properties": {
                "kind": {
                  "anyOf": [
                    { "type": "string", "const": "Event" },
                    { "type": "string", "const": "Command" }
                  ]
                },
                "type": { "type": "string", "minLength": 1 },
                "data": {
                  "type": "object",
                  "patternProperties": { "^.*$": {} }
                },
                "metadata": {
                  "type": "object",
                  "patternProperties": { "^.*$": {} }
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "AppendResult": {
        "type": "object",
        "required": [
          "streamName",
          "nextExpectedStreamVersion",
          "createdNewStream"
        ],
        "properties": {
          "streamName": { "type": "string" },
          "nextExpectedStreamVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "createdNewStream": { "type": "boolean" },
          "lastEventGlobalPosition": {
            "type": "string",
            "description": "Present only when the backend provides it."
          }
        }
      },
      "RecordedMessage": {
        "type": "object",
        "required": ["kind", "type", "data", "metadata"],
        "properties": {
          "kind": {
            "anyOf": [
              { "type": "string", "const": "Event" },
              { "type": "string", "const": "Command" }
            ]
          },
          "type": { "type": "string" },
          "data": { "type": "object", "patternProperties": { "^.*$": {} } },
          "metadata": {
            "type": "object",
            "required": ["messageId", "streamName", "streamPosition"],
            "properties": {
              "messageId": { "type": "string" },
              "streamName": { "type": "string" },
              "streamPosition": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "additionalProperties": true,
            "description": "Emmett's combined metadata: user metadata plus recording metadata produced by the event store, e.g. `globalPosition` and `checkpoint` when the backend returns them."
          }
        }
      },
      "HalResource": {
        "type": "object",
        "required": ["_links"],
        "properties": {
          "_links": { "type": "object", "patternProperties": { "^.*$": {} } },
          "_embedded": {
            "type": "object",
            "patternProperties": { "^.*$": {} }
          },
          "_templates": {
            "type": "object",
            "patternProperties": { "^.*$": {} }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string" },
          "traceId": { "type": "string" }
        },
        "additionalProperties": true
      },
      "StreamCatalogPage": {
        "type": "object",
        "required": ["streams"],
        "properties": {
          "streams": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ListedStream" }
          },
          "nextCursor": {
            "type": "string",
            "description": "Opaque continuation token. Clients must not parse it."
          }
        }
      },
      "StreamCatalogPageHal": {
        "type": "object",
        "required": ["_embedded", "_links"],
        "properties": {
          "_embedded": {
            "type": "object",
            "required": ["streams"],
            "properties": {
              "streams": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ListedStream" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              }
            }
          },
          "_links": { "type": "object", "patternProperties": { "^.*$": {} } }
        }
      },
      "MessagePage": {
        "type": "object",
        "required": ["streamName", "currentStreamVersion", "messages"],
        "properties": {
          "streamName": { "type": "string" },
          "currentStreamVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecordedMessage" }
          }
        }
      },
      "MessagePageHal": {
        "type": "object",
        "required": [
          "streamName",
          "currentStreamVersion",
          "_embedded",
          "_links"
        ],
        "properties": {
          "streamName": { "type": "string" },
          "currentStreamVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "_embedded": {
            "type": "object",
            "required": ["messages"],
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/components/schemas/RecordedMessage" },
                    { "$ref": "#/components/schemas/HalResource" }
                  ]
                }
              }
            }
          },
          "_links": { "type": "object", "patternProperties": { "^.*$": {} } },
          "_templates": {
            "type": "object",
            "patternProperties": { "^.*$": {} }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key managed through the server configuration."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC access token issued by a configured external issuer."
      }
    }
  }
}
