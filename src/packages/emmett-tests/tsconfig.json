{
  "extends": "../../tsconfig.shared.json",
  "include": ["./src/**/*"],
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist" /* Redirect output structure to the directory. */,
    "rootDir": "./src",
    "paths": {
      "@event-driven-io/almanac": ["../almanac/src"],
      "@event-driven-io/emmett": ["../emmett/src"],
      "@event-driven-io/emmett-esdb": ["../emmett-esdb/src"],
      "@event-driven-io/emmett-postgresql": ["../emmett-postgresql/src"],
      "@event-driven-io/emmett-sqlite": ["../emmett-sqlite/src"],
      "@event-driven-io/emmett-mongodb": ["../emmett-mongodb/src"],
      "@event-driven-io/emmett-testcontainers": ["../emmett-testcontainers/src"]
    }
  },
  "references": [
    {
      "path": "../almanac/"
    },
    {
      "path": "../emmett/"
    },
    {
      "path": "../emmett-esdb/"
    },
    {
      "path": "../emmett-postgresql/"
    },
    {
      "path": "../emmett-sqlite/"
    },
    {
      "path": "../emmett-mongodb/"
    },
    {
      "path": "../emmett-testcontainers/"
    }
  ]
}
