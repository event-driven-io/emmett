{
  "name": "@event-driven-io/core",
  "type": "module",
  "version": "0.43.0-beta.54",
  "description": "Emmett - Event Sourcing development made simple",
  "engines": {
    "node": ">=24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "private": true,
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "build": "run-s build:ts build:almanac build:emmett build:esdb build:mongodb build:postgresql build:sqlite build:expressjs build:honojs build:fastify build:testcontainers build:tests",
    "build:ts": "tsc -b tsconfig.json tsconfig.cloudflare.json",
    "build:ts:clean": "tsc --build --clean",
    "build:ts:watch": "tsc -b tsconfig.json tsconfig.cloudflare.json --watch",
    "build:almanac": "npm run build -w packages/almanac",
    "build:emmett": "npm run build -w packages/emmett",
    "build:esdb": "npm run build -w packages/emmett-esdb",
    "build:mongodb": "npm run build -w packages/emmett-mongodb",
    "build:postgresql": "npm run build -w packages/emmett-postgresql",
    "build:sqlite": "npm run build -w packages/emmett-sqlite",
    "build:expressjs": "npm run build -w packages/emmett-expressjs",
    "build:honojs": "npm run build -w packages/emmett-honojs",
    "build:fastify": "npm run build -w packages/emmett-fastify",
    "build:testcontainers": "npm run build -w packages/emmett-testcontainers",
    "build:tests": "npm run build -w packages/emmett-tests",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:prettier": "prettier --cache --config .prettierrc.json --check \"**/**/*.{json,md}\" \"../*.md\" \"../.{claude,codex,opencode}/**/*.{json,md,ts}\" \"../.agents/**/*.{json,ts}\"",
    "lint:eslint": "eslint --cache '**/*.ts'",
    "fix": "run-s fix:eslint fix:prettier",
    "agent:check": "run-s fix build:ts",
    "fix:prettier": "prettier --cache --config .prettierrc.json --write \"**/**/*.{json,md}\" \"../*.md\" \"../.{claude,codex,opencode}/**/*.{json,md,ts}\" \"../.agents/**/*.{json,ts}\"",
    "fix:eslint": "eslint --cache '**/*.ts' --fix",
    "test": "run-s test:unit test:int test:e2e",
    "test:unit": "vitest run \".unit.spec\"",
    "test:int": "vitest run \".int.spec\"",
    "test:int:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "types:cloudflare": "wrangler types packages/emmett-sqlite/worker-configuration.d.ts --config packages/emmett-sqlite/wrangler.durable-object.jsonc --include-runtime=false",
    "types:cloudflare:check": "wrangler types packages/emmett-sqlite/worker-configuration.d.ts --config packages/emmett-sqlite/wrangler.durable-object.jsonc --include-runtime=false --check",
    "test:e2e": "vitest run \".e2e.spec\"",
    "test:bundle": "vitest run --project bundle",
    "test:compat": "run-s test:compat:esm test:compat:browser test:compat:declarations:commonjs test:compat:declarations:esm test:compat:bun",
    "test:compat:local": "run-s build test:compat",
    "test:compat:esm": "node e2e/installLocalPackages.ts npm e2e/esmCompatibility almanac emmett",
    "test:compat:browser": "node e2e/installLocalPackages.ts npm e2e/browser almanac emmett",
    "test:compat:declarations:commonjs": "node e2e/installLocalPackages.ts npm e2e/libraryDeclarations/commonjs almanac emmett emmett-postgresql",
    "test:compat:declarations:esm": "node e2e/installLocalPackages.ts npm e2e/libraryDeclarations/esm almanac emmett emmett-postgresql",
    "test:compat:bun": "node e2e/installLocalPackages.ts bun e2e/bun almanac emmett",
    "test:watch": "vitest",
    "test:unit:watch": "vitest \".unit.spec\"",
    "test:int:watch": "vitest \".int.spec\"",
    "test:e2e:watch": "vitest \".e2e.spec\"",
    "test:file": "vitest run --no-file-parallelism --reporter=verbose",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench": "run-s bench:sqlite bench:postgresql",
    "bench:sqlite": "npm run bench -w packages/emmett-sqlite",
    "bench:postgresql": "npm run bench -w packages/emmett-postgresql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/event-driven-io/emmett.git"
  },
  "keywords": [
    "Event Sourcing"
  ],
  "author": "Oskar Dudycz",
  "bugs": {
    "url": "https://github.com/event-driven-io/emmett/issues"
  },
  "homepage": "https://event-driven-io.github.io/emmett/",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261025.1",
    "@eslint/js": "^10.0.1",
    "@event-driven-io/pongo": "0.17.0-rc.1",
    "@faker-js/faker": "^10.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "miniflare": "^4.20260730.0",
    "mitata": "^1.0.34",
    "npm-run-all2": "^9.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rolldown": "^1.2.15",
    "supertest": "7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uuid": "^14.0.3",
    "vitepress": "^2.0.0-alpha.21",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "workspaces": [
    "packages/almanac",
    "packages/emmett",
    "packages/emmett-postgresql",
    "packages/emmett-mongodb",
    "packages/emmett-esdb",
    "packages/emmett-expressjs",
    "packages/emmett-honojs",
    "packages/emmett-sqlite",
    "packages/emmett-testcontainers",
    "packages/emmett-fastify",
    "packages/emmett-tests"
  ],
  "allowScripts": {
    "workerd@1.20260730.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
